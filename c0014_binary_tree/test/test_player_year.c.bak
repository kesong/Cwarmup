#include "log.h"
#include "print_ADT.h"
#include "test_player.h"

void init_player_year_tree() {
  NODE *root_node = NULL;
  root_node = (NODE *)malloc(sizeof(NODE));
  root_node->ptr_data = NULL;
  root_node->left = NULL;
  root_node->right = NULL;
}

NODE *search_year_leaf(NODE *start_node, NODE *search_node) {
  if (start_node != NULL && start_node->ptr_data != NULL) {
    char *start_player_name = (char *)(start_node->ptr_data);
    char *search_player_name = (char *)(search_node->ptr_data);
    if (!strcmp(start_player_name, search_player_name)) {
      return start_node;
    }
    search_year_leaf(start_node->left, search_node);
    search_year_leaf(start_node->right, search_node);
  }
  return NULL;
}

NODE *search_left_year_NULL_leaf(NODE *start_node) {
  if (start_node == NULL) {
    return NULL;
  }
  if (start_node->right != NULL) {
    search_left_year_NULL_leaf(start_node->right);
  }
  return start_node;
}

void delete_year_leaf(NODE *targ_node) {
  NODE *parent_root_right_leaf = NULL;
  if (root_node != NULL && root_node->ptr_data != NULL) {
    NODE *parent_node = NULL;
    NODE *child_node = NULL;
    NODE *del_node = NULL;
    NODE *left_child_node = NULL;
    NODE *right_child_node = NULL;
    int *targ_year = (int *)(targ_node->ptr_data);
    int *root_year = (int *)(root_node->ptr_data);
    if (targ_node == root_node || *targ_year == *root_year) {
      if (root_node->left == NULL && root_node->right != NULL) {
        root_node = root_node->right;
        return NULL;
      } else if (root_node->left != NULL && root_node->right == NULL) {
        root_node = root_node->right;
        return NULL;
      } else if (root_node->left != NULL && root_node->right != NULL) {
        parent_root_right_leaf = search_left_year_NULL_leaf(root_node->left);
        if (parent_root_right_leaf != NULL) {
          parent_root_right_leaf->right = root_node->right;
          root_node = root_node->left;
          return NULL;
        } else {
          log_e("%s", "error occured when find the left null leaf.");
          return NULL;
        }
      }
    }
    parent_node = search_year_leaf(root_node, targ_node);
    left_child_node = search_year_leaf(parent_node->left, targ_node);
    right_child_node = search_year_leaf(parent_node->right, targ_node);
    int *left_child_year = (int *)(parent_node->left->ptr_data);
    int *right_child_year = (int *)(parent_node->right->ptr_data);
    if (*left_child_year == *targ_year) {
      del_node = left_child_node;
    } else if (*right_child_year == *targ_year) {
      del_node = right_child_node;
    }
    if (del_node->left != NULL && del_node->left->ptr_data != NULL) {
      if (parent_node->left->left == NULL && parent_node->left->right == NULL) {
        parent_node->left = NULL;
        free(del_node);
        return NULL;
      }
      if (parent_node->left->left != NULL && parent_node->left->right == NULL) {
        parent_node->left = parent_node->left->left;
        return NULL;
      }
      if (parent_node->left->left == NULL && parent_node->left->right != NULL) {
        parent_node->left = parent_node->left->right;
        return NULL;
      }
    } else if (del_node->right != NULL && del_node->right->ptr_data != NULL) {
      if (parent_node->left->left == NULL && parent_node->left->right == NULL) {
        parent_node->right = NULL;
        free(del_node);
        return NULL;
      }
      if (parent_node->left->left != NULL && parent_node->left->right == NULL) {
        parent_node->right = parent_node->left->left;
        return NULL;
      }
      if (parent_node->left->left == NULL && parent_node->left->right != NULL) {
        parent_node->right = parent_node->left->right;
        return NULL;
      }
    }
  }
}

