CC=cc
CFLAGS=-Wall -g -I $(INCLUDE_DIR)
#LDFLAGS=
VPATH=src include test

SRC_DIR=src
BIN_DIR=bin
INCLUDE_DIR=include
TEST_DIR=test

SRCS=$(wildcard $(SRC_DIR)/*.c) $(wildcard $(TEST_DIR)/*.c)
OBJS=$(patsubst %.c, $(BIN_DIR)/%.o, $(notdir $(wildcard $(SRCS))))
TARGETS=$(BIN_DIR)/$(basename $(notdir $(wildcard $(TEST_DIR)/*.c)))

#使用这个makefile要注意修改src，test目录下的双引号中#include 头文件的写法

#写法三， 一步生成可执行文件test_stack
#对应的编译命令为: cc -Wall -g -I include src/stack.c test/test_stack.c -o bin/test_stack
$(TARGETS): $(SRCS)
	@mkdir $(BIN_DIR)
	$(CC) $(CFLAGS) $^ -o $@


